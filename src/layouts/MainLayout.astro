---
import FooterSocials from "../components/FooterSocials.astro";
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/main-layout.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Crimson+Text:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  </head>

  <body>
    <div class="parchment-wrapper">
      <header class="tome-header">
        <h1>{title}</h1>
        <p>{description}</p>
      </header>

      <main class="tome-content">
        <slot />
      </main>

<footer class="tome-footer">
<FooterSocials />
</footer>
  </body>
</html>



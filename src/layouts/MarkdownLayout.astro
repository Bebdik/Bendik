---
interface Props {
  title: string;
  tags: string[];
}
const { title, tags } = Astro.props as Props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Crimson+Text:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="parchment-wrapper">
      <header class="tome-header">
        <h1>{title}</h1>
        {tags && tags.length > 0 && (
  <p class="tag-block">
  <em>Tags:</em>
  {tags.map((tag) => (
    <a href={`/obsidian/tags/${tag.toLowerCase()}`} class="tag-link">{tag}</a>
  ))}
</p>
)}

      </header>

      <main class="tome-content">
        <slot />
      </main>

      <footer class="tome-footer">
        <a class="ancient-link" href="javascript:history.back()">← Return to Previous Page</a>
        <div class="footer-ornament">※</div>
      </footer>
    </div>
  </body>
</html>

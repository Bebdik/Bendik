---
import { getCollection } from "astro:content";
import IndexLayout from '../../layouts/IndexLayout.astro';

const entries = await getCollection("work", ({ data }) => data.publish !== false);
const title = "Work Index";
const description = "Welcome to my professional archive. Explore my CV, projects, and more";
---

<IndexLayout title={title} description={description}>
  <ul class="entry-list">
    {entries.map(entry => (
      <li>
        <a class="entry-link" href={`/work/${entry.slug}`}>
          {entry.data.title}
        </a>
      </li>
    ))}
  </ul>
</IndexLayout>
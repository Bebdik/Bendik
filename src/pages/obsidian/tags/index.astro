---
import { getCollection } from 'astro:content';
import MarkdownLayout from '../../../layouts/MarkdownLayout.astro';

const entries = await getCollection('obsidian-meta');

// Build tag counts
const tagMap = new Map();

entries.forEach(entry => {
  const tags = entry.data.tags ?? [];
  tags.forEach(tag => {
    const lower = tag.toLowerCase();
    if (tagMap.has(lower)) {
      tagMap.set(lower, tagMap.get(lower) + 1);
    } else {
      tagMap.set(lower, 1);
    }
  });
});

// Convert to array for rendering
const tagList = Array.from(tagMap.entries()).sort();
---

<MarkdownLayout title="Tags in the Vault" tags={[]}>
  <div class="tag-grid">
    {tagList.map(([tag, count]) => (
  <a class="tag-link" href={`/obsidian/tags/${tag}`}>
    ✷ {tag} ({count})
  </a>
))}
  </div>
</MarkdownLayout>
